	pages = {413--422},
	file = {Full Text PDF:/Users/bimandra/Zotero/storage/GXRUWHWC/Walker et al. - 2020 - The impact of COVID-19 and strategies for mitigation and suppression in low- and middle-income count.pdf:application/pdf},
